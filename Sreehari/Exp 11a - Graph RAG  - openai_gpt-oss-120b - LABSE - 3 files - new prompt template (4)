{"cells":[{"cell_type":"code","execution_count":null,"metadata":{"colab":{"background_save":true,"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":808,"status":"ok","timestamp":1784126435141,"user":{"displayName":"Sreehari R","userId":"03803955901359101121"},"user_tz":-60},"id":"W59oeW5TARXM","outputId":"ffc18712-7c50-421e-dd5c-4bcb07f898fb"},"outputs":[{"name":"stdout","output_type":"stream","text":["\u001b[2K   \u001b[90m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m \u001b[32m2.4/2.4 MB\u001b[0m \u001b[31m28.1 MB/s\u001b[0m eta \u001b[36m0:00:00\u001b[0m\n","\u001b[2K   \u001b[90m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m \u001b[32m1.0/1.0 MB\u001b[0m \u001b[31m49.4 MB/s\u001b[0m eta \u001b[36m0:00:00\u001b[0m\n","\u001b[2K   \u001b[90m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m \u001b[32m61.7/61.7 kB\u001b[0m \u001b[31m3.8 MB/s\u001b[0m eta \u001b[36m0:00:00\u001b[0m\n","\u001b[2K   \u001b[90m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m \u001b[32m73.1/73.1 kB\u001b[0m \u001b[31m4.6 MB/s\u001b[0m eta \u001b[36m0:00:00\u001b[0m\n","\u001b[?25h\u001b[31mERROR: pip's dependency resolver does not currently take into account all the packages that are installed. This behaviour is the source of the following dependency conflicts.\n","google-colab 1.0.0 requires requests==2.32.4, but you have requests 2.34.2 which is incompatible.\u001b[0m\u001b[31m\n","\u001b[2K   \u001b[90m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m \u001b[32m18.5/18.5 MB\u001b[0m \u001b[31m121.1 MB/s\u001b[0m eta \u001b[36m0:00:00\u001b[0m\n","\u001b[2K   \u001b[90m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m \u001b[32m143.7/143.7 kB\u001b[0m \u001b[31m3.8 MB/s\u001b[0m eta \u001b[36m0:00:00\u001b[0m\n","\u001b[?25hAll dependencies installed.\n"]}],"source":["# ── CELL 1: Install dependencies ─────────────────────────────────────────────\n","!pip install -q langchain-community langchain-text-splitters langchain-core\n","!pip install -q sentence-transformers faiss-cpu\n","!pip install -q pandas openpyxl networkx\n","!pip install -q groq openai\n","print(\"All dependencies installed.\")"]},{"cell_type":"markdown","source":["Recursivecharactertextsplitter in langchain-text-splitters used to flatten corpus into 500 character chunks with 150 overlap.\n","langchain-community suppies huggingfaceembeddings and the FAISS vector store wrapper.\n","pandas read all workbooks, assembles into dataframes and write the result files.\n","openpyxl is the engine pandas dispatches for xlsx.\n","networkx provides the DiGraph\n","groq is the generator client.  it calls llm hosted on Groq.\n"],"metadata":{"id":"_Dt8_iPYcbLG"}},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"background_save":true,"base_uri":"https://localhost:8080/","height":38},"id":"WcWoBNP6BGrM","outputId":"10546144-43e8-4636-b997-f23aa58b2017"},"outputs":[{"data":{"text/html":["\n","     <input type=\"file\" id=\"files-0eb25d55-ffce-4321-8cd5-576e5b40cc6f\" name=\"files[]\" multiple disabled\n","        style=\"border:none\" />\n","     <output id=\"result-0eb25d55-ffce-4321-8cd5-576e5b40cc6f\">\n","      Upload widget is only available when the cell has been executed in the\n","      current browser session. Please rerun this cell to enable.\n","      </output>\n","      <script>// Copyright 2017 Google LLC\n","//\n","// Licensed under the Apache License, Version 2.0 (the \"License\");\n","// you may not use this file except in compliance with the License.\n","// You may obtain a copy of the License at\n","//\n","//      http://www.apache.org/licenses/LICENSE-2.0\n","//\n","// Unless required by applicable law or agreed to in writing, software\n","// distributed under the License is distributed on an \"AS IS\" BASIS,\n","// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n","// See the License for the specific language governing permissions and\n","// limitations under the License.\n","\n","/**\n"," * @fileoverview Helpers for google.colab Python module.\n"," */\n","(function(scope) {\n","function span(text, styleAttributes = {}) {\n","  const element = document.createElement('span');\n","  element.textContent = text;\n","  for (const key of Object.keys(styleAttributes)) {\n","    element.style[key] = styleAttributes[key];\n","  }\n","  return element;\n","}\n","\n","// Max number of bytes which will be uploaded at a time.\n","const MAX_PAYLOAD_SIZE = 100 * 1024;\n","\n","function _uploadFiles(inputId, outputId) {\n","  const steps = uploadFilesStep(inputId, outputId);\n","  const outputElement = document.getElementById(outputId);\n","  // Cache steps on the outputElement to make it available for the next call\n","  // to uploadFilesContinue from Python.\n","  outputElement.steps = steps;\n","\n","  return _uploadFilesContinue(outputId);\n","}\n","\n","// This is roughly an async generator (not supported in the browser yet),\n","// where there are multiple asynchronous steps and the Python side is going\n","// to poll for completion of each step.\n","// This uses a Promise to block the python side on completion of each step,\n","// then passes the result of the previous step as the input to the next step.\n","function _uploadFilesContinue(outputId) {\n","  const outputElement = document.getElementById(outputId);\n","  const steps = outputElement.steps;\n","\n","  const next = steps.next(outputElement.lastPromiseValue);\n","  return Promise.resolve(next.value.promise).then((value) => {\n","    // Cache the last promise value to make it available to the next\n","    // step of the generator.\n","    outputElement.lastPromiseValue = value;\n","    return next.value.response;\n","  });\n","}\n","\n","/**\n"," * Generator function which is called between each async step of the upload\n"," * process.\n"," * @param {string} inputId Element ID of the input file picker element.\n"," * @param {string} outputId Element ID of the output display.\n"," * @return {!Iterable<!Object>} Iterable of next steps.\n"," */\n","function* uploadFilesStep(inputId, outputId) {\n","  const inputElement = document.getElementById(inputId);\n","  inputElement.disabled = false;\n","\n","  const outputElement = document.getElementById(outputId);\n","  outputElement.innerHTML = '';\n","\n","  const pickedPromise = new Promise((resolve) => {\n","    inputElement.addEventListener('change', (e) => {\n","      resolve(e.target.files);\n","    });\n","  });\n","\n","  const cancel = document.createElement('button');\n","  inputElement.parentElement.appendChild(cancel);\n","  cancel.textContent = 'Cancel upload';\n","  const cancelPromise = new Promise((resolve) => {\n","    cancel.onclick = () => {\n","      resolve(null);\n","    };\n","  });\n","\n","  // Wait for the user to pick the files.\n","  const files = yield {\n","    promise: Promise.race([pickedPromise, cancelPromise]),\n","    response: {\n","      action: 'starting',\n","    }\n","  };\n","\n","  cancel.remove();\n","\n","  // Disable the input element since further picks are not allowed.\n","  inputElement.disabled = true;\n","\n","  if (!files) {\n","    return {\n","      response: {\n","        action: 'complete',\n","      }\n","    };\n","  }\n","\n","  for (const file of files) {\n","    const li = document.createElement('li');\n","    li.append(span(file.name, {fontWeight: 'bold'}));\n","    li.append(span(\n","        `(${file.type || 'n/a'}) - ${file.size} bytes, ` +\n","        `last modified: ${\n","            file.lastModifiedDate ? file.lastModifiedDate.toLocaleDateString() :\n","                                    'n/a'} - `));\n","    const percent = span('0% done');\n","    li.appendChild(percent);\n","\n","    outputElement.appendChild(li);\n","\n","    const fileDataPromise = new Promise((resolve) => {\n","      const reader = new FileReader();\n","      reader.onload = (e) => {\n","        resolve(e.target.result);\n","      };\n","      reader.readAsArrayBuffer(file);\n","    });\n","    // Wait for the data to be ready.\n","    let fileData = yield {\n","      promise: fileDataPromise,\n","      response: {\n","        action: 'continue',\n","      }\n","    };\n","\n","    // Use a chunked sending to avoid message size limits. See b/62115660.\n","    let position = 0;\n","    do {\n","      const length = Math.min(fileData.byteLength - position, MAX_PAYLOAD_SIZE);\n","      const chunk = new Uint8Array(fileData, position, length);\n","      position += length;\n","\n","      const base64 = btoa(String.fromCharCode.apply(null, chunk));\n","      yield {\n","        response: {\n","          action: 'append',\n","          file: file.name,\n","          data: base64,\n","        },\n","      };\n","\n","      let percentDone = fileData.byteLength === 0 ?\n","          100 :\n","          Math.round((position / fileData.byteLength) * 100);\n","      percent.textContent = `${percentDone}% done`;\n","\n","    } while (position < fileData.byteLength);\n","  }\n","\n","  // All done.\n","  yield {\n","    response: {\n","      action: 'complete',\n","    }\n","  };\n","}\n","\n","scope.google = scope.google || {};\n","scope.google.colab = scope.google.colab || {};\n","scope.google.colab._files = {\n","  _uploadFiles,\n","  _uploadFilesContinue,\n","};\n","})(self);\n","</script> "],"text/plain":["<IPython.core.display.HTML object>"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["Saving Counterfactual Sentence Pairs Malayalam.xlsx to Counterfactual Sentence Pairs Malayalam.xlsx\n","Saving Gender-Inclusive Sentence Pairs Malayalam.xlsx to Gender-Inclusive Sentence Pairs Malayalam.xlsx\n","Saving Gender-Neutral Pairs Malayalam.xlsx to Gender-Neutral Pairs Malayalam.xlsx\n","Saving inclusive and counterfactual.xlsx to inclusive and counterfactual.xlsx\n","Saved: Counterfactual Sentence Pairs Malayalam.xlsx\n","Saved: Gender-Inclusive Sentence Pairs Malayalam.xlsx\n","Saved: Gender-Neutral Pairs Malayalam.xlsx\n","Saved: inclusive and counterfactual.xlsx\n","GN: /content/Gender-Neutral Pairs Malayalam.xlsx\n","CF: /content/Counterfactual Sentence Pairs Malayalam.xlsx\n","GI: /content/Gender-Inclusive Sentence Pairs Malayalam.xlsx\n","REF (optional): /content/inclusive and counterfactual.xlsx\n"]}],"source":["# ── CELL 2: Upload the FOUR files ─────────────────────────────────────────────\n","\n","from google.colab import files\n","import os, glob#, shutil\n","\n","uploaded = files.upload()#blocked untill files are choosen\n","for fn, content in uploaded.items():\n","    with open(f\"/content/{fn}\", \"wb\") as f:\n","        f.write(content)\n","    print(\"Saved:\", fn)\n","\n","def _find(*kw):\n","    for p in glob.glob(\"/content/*.xlsx\"):\n","        name = os.path.basename(p).lower().replace(\"_\",\" \").replace(\"-\",\" \")\n","        if all(k in name for k in kw):\n","            return p\n","    return None\n","\n","GN_PATH  = _find(\"gender\",\"neutral\")\n","CF_PATH  = _find(\"counterfactual\",\"sentence\")\n","GI_PATH  = _find(\"inclusive\",\"sentence\",\"pairs\")\n","REF_PATH = _find(\"inclusive\",\"and\",\"counterfactual\")\n","for nm,p in [(\"GN\",GN_PATH),(\"CF\",CF_PATH),(\"GI\",GI_PATH),(\"REF (optional)\",REF_PATH)]:\n","    print(f\"{nm}: {p}\")\n","assert GN_PATH and CF_PATH and GI_PATH, \"Upload the three corpus files.\""]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"background_save":true},"id":"VYhTi50MBQVW","outputId":"6f3c6057-d35c-4972-e22c-9c0875993d2c"},"outputs":[{"name":"stdout","output_type":"stream","text":["Language pack loaded: 21 case endings, 6 group seeds, 7 gate seed words.\n"]}],"source":["# ── CELL 3: LANGUAGE PACK — the ONLY language-specific cell ───────────────────\n","import re\n","\n","LANG = {\n","    #  corpus column names\n","    \"gn_src_col\": \"Original Terms (Malayalam)\",\n","    \"gn_tgt_col\": \"Corrected Translation(Inclusive Terms)\",\n","    \"cf_src_col\": \"Biased Sentence(Malayalam)\",\n","    \"cf_tgt_col\": \"Counterfactual Sentence(Malayalam)\",\n","    \"gi_src_col\": \"non-inclusive (Malayalam)\",\n","    \"gi_tgt_col\": \"inclusive (Malayalam)\",\n","\n","    # works as the tokeniser. how to find target-language words in text\n","    \"word_regex\": re.compile(r\"[\\u0D00-\\u0D7F]+\"),\n","    #U+0D00 to U+0D7F is the Malayalam Unicode block\n","\n","    # ── morphology classifiers used ONLY by the KG build (Stage 1 metadata) ──\n","    \"suff_fem\":    re.compile(r\"(കാരി|ക്കാരി|ത്തി|വതി|ിനി|ിക|േച്ചി|ശ്ശി)$\"),\n","    \"suff_masc\":   re.compile(r\"(കാരൻ|ക്കാരൻ|നായ|വാൻ|ച്ഛൻ|ട്ടൻ)$\"),\n","    \"masc_nfinal\": re.compile(r\"(?<![ാേീ])ൻ$\"),\n","    \"masc_plur\":   re.compile(r\"(ന്മാർ)$\"),\n","    \"fem_stems\":   (\"സ്ത്രീ\",\"പെൺ\",\"അമ്മ\",\"മകൾ\",\"സഹോദരി\",\"ഭാര്യ\",\"രാജ്ഞി\",\"നടി\",\"വിധവ\",\"കാമുകി\"),\n","    \"masc_stems\":  (\"പുരുഷ\",\"ആൺ\",\"അച്ഛ\",\"മകൻ\",\"സഹോദരൻ\",\"ഭർത്താ\",\"രാജാവ\",\"നടൻ\",\"കാമുകൻ\"),\n","    \"plural_end\":  re.compile(r\"(ന്മാർ|മാർ|കൾ|ങ്ങൾ|ർ|ജനങ്ങൾ|ആളുകൾ)$\"),\n","    \"stem_strip\":  re.compile(r\"[ൻർൾളനം:ഃ]$\"),\n","\n","    # ── query-time case/postposition endings (lookup normalization) ─────────\n","    \"case_suffixes\": [\"ന്റെ\",\"യുടെ\",\"ുടെ\",\"ിന്\",\"ിനെ\",\"ിനോട്\",\"ിലേക്ക്\",\"ിലുള്ള\",\"ിൽ\",\"ോട്\",\n","                      \"ാൽ\",\"െക്കാൾ\",\"േക്കാൾ\",\"ക്കായി\",\"ിനായി\",\"നെ\",\"യെ\",\"രെ\",\"ളെ\",\"ക്ക്\",\"ം\"],\n","    \"final_strip\": re.compile(r\"[ൻർൾം]$\"),\n","\n","    # ── group seeds (gendered group nouns for counter-example attachment) ────\n","    \"group_seeds\": {\"സ്ത്രീ\":\"സ്ത്രീകൾ\",\"പുരുഷ\":\"പുരുഷന്മാർ\",\"ആൺകുട്ടി\":\"ആൺകുട്ടികൾ\",\n","                    \"പെൺകുട്ടി\":\"പെൺകുട്ടികൾ\",\"പെണ്ണുങ്ങ\":\"പെണ്ണുങ്ങൾ\",\"ആണുങ്ങ\":\"ആണുങ്ങൾ\"},\n","\n","    # ── quality-gate seeds (pronouns etc. NOT derivable from the term corpus);\n","    #    the rest of the gate lexicon is DERIVED from the KG at run time ──────\n","    \"gate_extra_gendered\": {\"അവൻ\",\"അവൾ\",\"അദ്ദേഹം\",\"ആൺ\",\"പെൺ\",\"പുരുഷ\",\"സ്ത്രീ\"},\n","    \"gate_neutral_allow\":  {\"വ്യക്തി\",\"കുട്ടി\",\"ആൾ\",\"ആളുകൾ\",\"അവർ\",\"മനുഷ്യർ\",\"എല്ലാവരും\"},\n","}\n","print(\"Language pack loaded:\")"]},{"cell_type":"markdown","source":["`word_regex` | Finds Malayalam words in running text. Skips blanks, Latin tokens and punctuation for free. | `kg_lookup`, Cell 8 |\n","`suff_fem` | Feminine derivational endings, anchored at word end. | `term_gender`, `term_suffix`, Cell 5 |\n","`suff_masc` | Masculine derivational endings, anchored at word end. | `term_gender`, `term_suffix`, Cell 5 |\n","`masc_nfinal` | The general rule that a final `ൻ` marks masculine. The lookbehind blocks `ാ`, `േ` and `ീ` before it. | `term_gender`, Cell 5 |\n","`masc_plur` | The masculine plural `ന്മാർ`. Listed on its own because the plural marker hides the singular ending underneath it. | `term_gender`, Cell 5 |\n","`fem_stems` | Feminine roots with no regular ending, such as `അമ്മ` and `നടി`. Substring test, not anchored. | `term_gender`, Cell 5 |\n","`masc_stems` | The same for masculine roots. | `term_gender`, Cell 5 |\n","`plural_end` | Number detection. This is what fills the AGREEMENT clause in the directive. | `term_number`, Cell 5 |\n","`stem_strip` | Removes one final consonant sign to give a short stem the graph can match on. | `stem`, Cell 5 |\n","`case_suffixes` | Case and postposition endings, stripped at lookup time so an inflected word still finds its node. Applied longest first. | `_norm`, Cell 8 |\n","`final_strip` | Cleans up whatever consonant sign the case strip leaves behind. | `_norm`, Cell 8 |\n","`group_seeds` | Six gendered group nouns, seeded so counter-example attachment has anchors even when the noun is not in the term pairs. | Stage 3, Cell 5 |\n","`gate_extra_gendered` | Pronouns and bare gender words the quality gate needs. The term corpus cannot supply them. | quality gate |\n","`gate_neutral_allow` | Generic person words the gate must not flag. | quality gate |\n","\n","\n","Therefore, Across the 518 source terms the rules assign 279 masculine by ending, 74\n","masculine by root, 56 feminine by root and 41 feminine by ending. 68 terms get\n","no label. Combined with number, this is what drives Stage 3, where 145\n","masculine plurals and 25 feminine plurals become group nodes, giving the 170\n","reclassifications reported in the paper.\n","\n","### Why the masculine gets a general rule and the feminine does not\n","\n","Malayalam does not mark the two genders the same way, and our rules follow the\n","language rather than fight it.\n","\n","Masculine words usually end in `ൻ`. A player is `കളിക്കാരൻ`. A local is\n","`നാട്ടുകാരൻ`. A newspaper delivery worker is `പത്ര വിതരണക്കാരൻ`. That ending\n","works like a flag. Almost nothing else in the language waves it, so we can look\n","for a final `ൻ` and be right most of the time. One short rule covers hundreds\n","of words.\n","\n","Feminine words usually end in `ി`. A woman player is `കളിക്കാരി`. A stage\n","artist is `വേദി കലാകാരി`. The problem is that this ending is everywhere. A\n","worker is `തൊഴിലാളി`. A person is `വ്യക്തി`. A child is `കുട്ടി`. None of\n","those are feminine. In our own corpus, 50 of the neutral replacement words end\n","in `ി`. So the ending tells us nothing about gender. A rule saying that a final\n","`ി` means feminine would fire on the very words we replace gendered terms with.\n","\n","That is why the feminine side is a list. We name `കാരി`, `ത്തി`, `ിനി` and\n","`ിക` one at a time. It is longer and less tidy than the masculine rule. It is\n","also the only thing that works.\n","\n","### Why the masculine plural gets its own rule and the feminine plural does not\n","\n","Watch what happens to a masculine word when it goes plural.\n","\n","`നാട്ടുകാരൻ` becomes `നാട്ടുകാരന്മാർ`. The `ൻ` is gone. The word now ends in\n","`ർ`. Our flag rule cannot see it any more, so we wrote a second rule just for\n","`ന്മാർ`. Without it we would lose 112 words in this corpus.\n","\n","Now watch a feminine word.\n","\n","`കളിക്കാരി` becomes `കളിക്കാരികൾ`. Nothing is replaced. Malayalam simply adds\n","`കൾ` on the end. The feminine part `കാരി` is still sitting there in the word.\n","\n","But our rules only look at the last few letters. Once `കൾ` is attached, `കാരി`\n","is no longer at the end. It has moved into the middle, and we stop seeing it.\n","Eleven words fall through this way, including `കളിക്കാരികൾ`,\n","`അലക്കുകാരികൾ` and `ബാർ ജോലിക്കാരികൾ`. They come out with no gender label at\n","all, so they keep a replacement directive where a counter directive would fit\n","better.\n","\n","We noticed this problem on the masculine side and wrote a rule for it. We did\n","not notice it on the feminine side. There is no property of Malayalam that\n","makes the gap correct. It is an oversight and we report it as one.\n","\n","\n","\n","\n"],"metadata":{"id":"0HNj6WX9k4v7"}},{"cell_type":"code","execution_count":null,"metadata":{"id":"FmqsvM8gBSR1"},"outputs":[],"source":["# ── CELL 4: Build FAISS index (3-file corpus, LaBSE) ──────────────────────────\n","import os, shutil, pandas as pd\n","from langchain_community.embeddings import HuggingFaceEmbeddings\n","from langchain_community.vectorstores import FAISS\n","from langchain_text_splitters import RecursiveCharacterTextSplitter\n","\n","VDB_PATH = \"/content/faiss_index\"#where the finished index gets sved on disk\n","EMBED_MODEL = \"sentence-transformers/LaBSE\"#th embedding model, trained on many languages including malayalam\n","\n","def get_embeddings():\n","    return HuggingFaceEmbeddings(model_name=EMBED_MODEL, model_kwargs={\"device\": \"cpu\"})\n","\n","gn = pd.read_excel(GN_PATH); gn.columns = gn.columns.str.strip()\n","gn_texts = [f\"{str(r[LANG['gn_src_col']]).strip()} -> {str(r[LANG['gn_tgt_col']]).strip()}\"\n","            for _, r in gn.iterrows()\n","            if pd.notna(r[LANG['gn_src_col']]) and pd.notna(r[LANG['gn_tgt_col']])\n","            and str(r[LANG['gn_src_col']]).strip() != str(r[LANG['gn_tgt_col']]).strip()]\n","\n","cf = pd.read_excel(CF_PATH); cf.columns = cf.columns.str.strip()\n","cf_texts = [f\"Biased: {str(r[LANG['cf_src_col']]).strip()} -> Inclusive: {str(r[LANG['cf_tgt_col']]).strip()}\"\n","            for _, r in cf.iterrows()\n","            if pd.notna(r[LANG['cf_src_col']]) and pd.notna(r[LANG['cf_tgt_col']])]\n","\n","gi = pd.read_excel(GI_PATH); gi.columns = gi.columns.str.strip()\n","gi_texts = [f\"Biased: {str(r[LANG['gi_src_col']]).strip()} -> Inclusive: {str(r[LANG['gi_tgt_col']]).strip()}\"\n","            for _, r in gi.iterrows()\n","            if pd.notna(r[LANG['gi_src_col']]) and pd.notna(r[LANG['gi_tgt_col']])]\n","\n","text = \"\\n\".join(gn_texts + cf_texts + gi_texts)\n","print(f\"Corpus: {len(gn_texts)} GN + {len(cf_texts)} CF + {len(gi_texts)} GI\")\n","chunks = RecursiveCharacterTextSplitter(chunk_size=500, chunk_overlap=150).split_text(text)\n","print(f\"Total chunks: {len(chunks)}\")\n","shutil.rmtree(V\n","DB_PATH, ignore_errors=True)\n","vectorstore_build = FAISS.from_texts(chunks, get_embeddings())\n","vectorstore_build.save_local(VDB_PATH)\n","print(f\"FAISS store saved ({EMBED_MODEL}).\")"]},{"cell_type":"markdown","source":["### What this cell does\n","\n","Our generator has never seen our corpus. When we hand it a sentence like\n","`ഒരു നല്ല അധ്യാപകൻ എപ്പോഴും ____ ആയിരിക്കണം`, it has no idea that our\n","spreadsheets already hold hundreds of worked examples of this exact kind of\n","rewrite.\n","\n","We cannot paste the whole corpus into every prompt. It runs to 232,638\n","characters, so it would not fit, and it would bury the actual question. So we\n","build a search system instead. At generation time we ask it which few lines of\n","our corpus look most like the new sentence, and only those go into the prompt.\n","\n","This cell builds that search system. Cell 8 uses it.\n","\n","#### Turning text into numbers\n","\n","A computer cannot compare two sentences for meaning on its own. So we turn each\n","piece of text into a long list of numbers. The model that does this is trained\n","so that texts with similar meaning end up with similar numbers. Sentences about\n","teachers land near other sentences about teachers. We call that list of numbers\n","an embedding.\n","\n","We use LaBSE because it was trained on many languages including Malayalam. A\n","model trained only on English would produce meaningless numbers for\n","`അധ്യാപകൻ`, and our retrieval step would return noise. We run it on CPU, which\n","is plenty for a corpus this size.\n","\n","#### Flattening the spreadsheets\n","\n","We cannot embed a spreadsheet, only text. So every row becomes one line.\n","\n","A term row becomes this.\n","\n","    പന്ത് എടുക്കുന്ന ആൺകുട്ടി -> പന്ത് എടുക്കുന്ന ആൾ\n","\n","A sentence row becomes this.\n","\n","    Biased: സ്ത്രീകൾ വൈകാരികമായി അസ്ഥിരരാണ്. -> Inclusive: എല്ലാ ലിംഗ സ്വത്വങ്ങളിലുള്ള ആളുകൾ വൈകാരികമായി സ്ഥിരതയുള്ളവരാണ്.\n","\n","The arrow and the words `Biased` and `Inclusive` are there for the generator to\n","read. When a few of these lines reach the prompt, it can see what changed.\n","\n","We skip rows where either column is empty, so a blank cell never becomes the\n","text `nan`. For the term rows we also skip any row where both sides are the\n","same, since a term that neutralises to itself teaches nothing. That gives us\n","518 term lines, 725 counterfactual lines and 1,036 inclusive lines.\n","\n","#### Gluing and cutting\n","\n","We stack all three lists and join them with newlines. The result is one long\n","text file of 2,279 lines. All three corpora now sit in one pile with nothing\n","marking where one ends and the next begins.\n","\n","We do not search that whole pile at once. We cut it into small blocks, because\n","when the retriever finds a match it hands back the whole block. A block has to\n","be small enough to stay focused and big enough to carry useful context. We ask\n","for blocks of about 500 characters.\n","\n","The splitter works down a list of preferred cutting points. It tries blank\n","lines first, then single newlines, then spaces, and only cuts mid word as a\n","last resort. Our longest line is 187 characters, so it never gets past the\n","newline stage. Every cut lands cleanly between two lines and no line is ever\n","chopped in half.\n","\n","We also let each block repeat the last 150 characters of the block before it. A\n","hard cut can separate two lines that belong together, and the repetition gives\n","us a second chance to retrieve a line that would otherwise sit alone at a seam.\n","The cost is redundancy. Our 232,638 characters become 314,225 characters spread\n","across blocks, and some lines turn up in as many as six of them.\n","\n","We end up with 728 blocks. Each block holds a handful of whole corpus lines.\n","Since we cut by character count, how many lines fit depends on how long they\n","are. Most blocks hold three or four sentence lines. A smaller group holds\n","twelve to twenty three term lines, because term lines are short enough to pack\n","many into the same 500 characters.\n","\n","#### Building and saving the index\n","\n","We delete any index left over from an earlier run first. Without that line a\n","stale index could survive a change to the corpus, which would quietly break\n","reproducibility.\n","\n","Then we send all 728 blocks through LaBSE, get 728 vectors back, and store them\n","in FAISS. FAISS does one job and does it fast, which is finding the vectors\n","closest to a query vector.\n","\n","We save it to disk in two pieces. One holds the vectors. The other holds the\n","original text of each block, so that when a search says block 412 is the\n","closest, we can hand back the actual Malayalam rather than a number.\n","\n","#### What retrieval actually returns\n","\n","This matters for reading our results. The block is the unit, not the line. A\n","whole block goes into the prompt, so when Cell 8 asks for the three nearest\n","blocks, the generator receives roughly nine to twelve corpus lines rather than\n","three. Some of those are genuinely close to the input. Others are simply\n","neighbours that happened to sit in the same block.\n","\n","Retrieval here is coarse by construction. The graph has no equivalent problem.\n","A node match returns that node and nothing else.\n","\n","#### Why this store is optional and the graph is not\n","\n","In Cell 8 we paste the retrieved blocks into the prompt under the heading\n","`CONTEXT (optional)`. That word is deliberate. These are blocks of loose text\n","that happened to look similar. Nothing in them tells the generator what to do.\n","They carry no instruction, no grammatical information, and no marking of what\n","kind of knowledge they are. A counterfactual line and an inclusive rewrite line\n","look identical here, both wrapped in `Biased:` and `Inclusive:`, so the\n","generator cannot tell one from the other. It may use them. It may ignore them.\n","That is its choice.\n","\n","The knowledge graph in Cell 5 holds the same corpus, but we treat it very\n","differently. A graph lookup is a match, not a guess. When a term in the input\n","matches a node, we know its gender, its number, what it should be replaced\n","with, and whether the right move is a replacement or a counter. We put that in\n","the prompt under `DIRECTIVES (authoritative — apply exactly)`, written as\n","commands with the number agreement spelled out.\n","\n","So the same corpus reaches the generator twice, once as suggestion and once as\n","instruction. That contrast is the point of the whole experiment. We are not\n","testing whether the corpus helps. We are testing whether it matters that the\n","knowledge arrives structured, typed and binding rather than flat and optional."],"metadata":{"id":"nmcw1xcrxpSs"}},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"background_save":true},"id":"zrp7ktO3BXPy"},"outputs":[],"source":["# ── CELL 5: Build Knowledge Graph — same stages/structure, LANG-driven ────────\n","#   Stage 1: GN pairs -> gendered/neutral term nodes + neutralizes_to edges,\n","#            with grammatical metadata (gender, suffix, number, stem)\n","#   Stage 2: GI pairs -> up to 2 example rewrites attached per gendered term\n","#   Stage 3: CF pairs -> up to 3 counter-examples attached to group nouns\n","import pickle, pandas as pd\n","import networkx as nx\n","\n","KG_PATH = \"/content/kg.pkl\"\n","\n","def term_gender(t):\n","    t = str(t)\n","    if LANG[\"suff_fem\"].search(t):  return \"feminine\"\n","    if LANG[\"masc_plur\"].search(t) or LANG[\"suff_masc\"].search(t) or LANG[\"masc_nfinal\"].search(t):\n","        return \"masculine\"\n","    if any(s in t for s in LANG[\"fem_stems\"]):  return \"feminine\"\n","    if any(s in t for s in LANG[\"masc_stems\"]): return \"masculine\"\n","    return \"unknown\"\n","\n","def term_suffix(t):\n","    m = LANG[\"suff_fem\"].search(str(t)) or LANG[\"suff_masc\"].search(str(t)) or LANG[\"masc_plur\"].search(str(t))\n","    if m: return m.group(1)\n","    return \"N-final\" if LANG[\"masc_nfinal\"].search(str(t)) else \"\"\n","\n","def term_number(t):\n","    return \"plural\" if LANG[\"plural_end\"].search(str(t)) else \"singular\"\n","\n","def stem(t):\n","    return LANG[\"stem_strip\"].sub(\"\", str(t).strip())\n","\n","G = nx.DiGraph()\n","\n","# Stage 1\n","gn = pd.read_excel(GN_PATH); gn.columns = gn.columns.str.strip()\n","n_pairs = 0\n","for _, r in gn.iterrows():\n","    org, inc = r.get(LANG['gn_src_col']), r.get(LANG['gn_tgt_col'])\n","    if pd.isna(org) or pd.isna(inc): continue\n","    org, inc = str(org).strip(), str(inc).strip()\n","    if not org or not inc or org == inc: continue\n","    G.add_node(org, kind=\"gendered\", gender=term_gender(org), suffix=term_suffix(org),\n","               number=term_number(org), stem=stem(org), examples=[])\n","    if inc not in G:\n","        G.add_node(inc, kind=\"neutral\", gender=\"neutral\", number=term_number(inc), stem=stem(inc))\n","    G.add_edge(org, inc, relation=\"neutralizes_to\")\n","    n_pairs += 1\n","\n","gendered_nodes = [n for n, d in G.nodes(data=True) if d.get(\"kind\") == \"gendered\"]\n","gendered_by_stem = sorted(gendered_nodes, key=lambda n: len(G.nodes[n][\"stem\"]), reverse=True)\n","\n","# Stage 2\n","gi = pd.read_excel(GI_PATH); gi.columns = gi.columns.str.strip()\n","n_ex = 0\n","for _, r in gi.iterrows():\n","    b, i2 = r.get(LANG['gi_src_col']), r.get(LANG['gi_tgt_col'])\n","    if pd.isna(b) or pd.isna(i2): continue\n","    b, i2 = str(b).strip(), str(i2).strip()\n","    for node in gendered_by_stem:\n","        st = G.nodes[node][\"stem\"]\n","        if len(st) >= 4 and st in b:\n","            if len(G.nodes[node][\"examples\"]) < 2:\n","                G.nodes[node][\"examples\"].append((b, i2)); n_ex += 1\n","            break\n","\n","# Stage 3\n","for g_stem, g_node in LANG[\"group_seeds\"].items():\n","    if g_node not in G:\n","        G.add_node(g_node, kind=\"group\", gender=\"mixed\", number=\"plural\",\n","                   stem=stem(g_node), counterexamples=[])\n","    else:\n","        G.nodes[g_node][\"kind\"] = \"group\"\n","        G.nodes[g_node].setdefault(\"counterexamples\", [])\n","for n in gendered_nodes:\n","    if G.nodes[n][\"number\"] == \"plural\" and G.nodes[n][\"gender\"] in (\"masculine\",\"feminine\"):\n","        G.nodes[n][\"kind\"] = \"group\"\n","        G.nodes[n].setdefault(\"counterexamples\", [])\n","\n","cfd = pd.read_excel(CF_PATH); cfd.columns = cfd.columns.str.strip()\n","n_cx = 0\n","group_nodes = [(n, G.nodes[n][\"stem\"]) for n, d in G.nodes(data=True) if d.get(\"kind\") == \"group\"]\n","for _, r in cfd.iterrows():\n","    b, c = r.get(LANG['cf_src_col']), r.get(LANG['cf_tgt_col'])\n","    if pd.isna(b) or pd.isna(c): continue\n","    b, c = str(b).strip(), str(c).strip()\n","    for g_node, g_st in group_nodes:\n","        if len(g_st) >= 3 and g_st in b and len(G.nodes[g_node][\"counterexamples\"]) < 3:\n","            G.nodes[g_node][\"counterexamples\"].append((b, c)); n_cx += 1\n","            break\n","\n","with open(KG_PATH, \"wb\") as f:\n","    pickle.dump(G, f)\n","print(f\"KG: {G.number_of_nodes()} nodes, {G.number_of_edges()} edges \"\n","      f\"(pairs {n_pairs}, examples {n_ex}, counter-examples {n_cx})\")\n","print(f\"Saved: {KG_PATH}\")"]},{"cell_type":"markdown","source":["815 nodes in total and 518 edges ; The edge count is fixed by the corpus no of element in gender neutral term pairs file.\n","This 518  distinct gendered source terms + 291  distinct neutral target+  6  seeded group nouns =\n"," 815  nodes. Neutral nodes are shared. Only 111 of your 291 neutral nodes sit in a clean one-to-one pair. The other 180 are hubs.\n"],"metadata":{"id":"2NBlCNGqkSx7"}},{"cell_type":"markdown","source":["### What this cell does\n","\n","Cell 4 turned our corpus into text that a search engine can look through. This\n","cell turns the same corpus into something different. A structure that knows\n","what each word is, what it should become, and what kind of problem it presents.\n","\n","We build it in three stages, one per corpus file.\n","\n","#### The nodes are words, not stems\n","\n","Every node in the graph is a whole Malayalam term. `അധ്യാപകൻ` is a node.\n","`കളിക്കാരി` is a node. The stem is not a node. It is one of several pieces of\n","information we store on the node, and it exists only to help us find that word\n","inside a sentence later.\n","\n","A node looks like this.\n","\n","    അധ്യാപകൻ\n","      gender    masculine\n","      suffix    N-final\n","      number    singular\n","      stem      അധ്യാപക\n","      examples  [ ... ]\n","      edge      neutralizes_to -> അധ്യാപകർ\n","\n","#### Stage 1, the skeleton\n","\n","We read the 518 term pairs. For each gendered term we run the four small\n","analyses from the language pack. `അധ്യാപകൻ` has no feminine suffix, and the\n","general masculine rule fires on the final `ൻ`, so it is masculine. No named\n","suffix matched, only the general rule, so we record `N-final`. There is no\n","plural ending, so it is singular. We strip one final letter to get the stem.\n","\n","Then we add the replacement as its own node and draw an edge between them.\n","\n","The important line is the one that checks whether the replacement already\n","exists. Neutral terms are shared. Look at what happens when the feminine\n","partner arrives from a different row.\n","\n","    അധ്യാപകൻ  (masculine, singular) ──┐\n","                                       ├──→ അധ്യാപകർ\n","    അധ്യാപിക  (feminine, singular)  ──┘\n","\n","Two rows that sat far apart in the spreadsheet are now visibly the same word in\n","two genders. This happens a lot. Our 518 gendered terms point at only 291\n","distinct replacements. One neutral term, `പ്രിയപ്പെട്ടവർ`, is the target of\n","four different gendered forms.\n","\n","That is the first thing the graph gives us that a two-column list cannot.\n","\n","#### Why we store a stem at all\n","\n","Malayalam adds case endings to the end of a word, so a word usually survives\n","inside its own inflected form. But not always.\n","\n","    അധ്യാപകൻ  becomes  അധ്യാപകനെ\n","\n","The final `ൻ` is a chillu, a consonant with no vowel after it. When a\n","vowel-initial ending attaches, it turns back into an ordinary `ന`. The last\n","letter of the citation form is simply not there any more, so searching for the\n","full word fails.\n","\n","Stripping that one letter gives `അധ്യാപക`, which survives into every inflected\n","form. That is the whole job. We remove one final letter, and only when it is\n","one of eight letters that behave this way.\n","\n","For 128 of our 518 terms nothing is stripped, because they end in a letter that\n","does not change. `അധ്യാപിക` is one of these, and its stem is identical to the\n","word.\n","\n","This is not real stemming and we do not claim it is. It is a narrow fix for the\n","one place where suffixing breaks prefix matching in Malayalam.\n","\n","#### Stage 2, hang worked examples on each term\n","\n","Now the 1,036 inclusive sentence pairs. Each one has to find the term it\n","belongs to.\n","\n","We sort the nodes by stem length, longest first, so a specific term claims a\n","sentence before a general one does. Then for each sentence we walk that list\n","and stop at the first node whose stem appears in it.\n","\n","    അധ്യാപിക\n","      അധ്യാപിക ഇന്ന് പരിപാടിയിൽ പങ്കെടുത്തു.\n","        -> അധ്യാപകർ ഇന്ന് പരിപാടിയിൽ പങ്കെടുത്തു.\n","      സംഘാടകർ അധ്യാപികയെ ടീമിൽ ഉൾപ്പെടുത്തി.\n","        -> സംഘാടകർ അധ്യാപകരെ ടീമിൽ ഉൾപ്പെടുത്തി.\n","\n","Look at the second one. The object marker changes from `യെ` to `രെ`. That is\n","the agreement consequence of the substitution, and no term pair on its own\n","could have shown it.\n","\n","We attach at most two per node. 979 examples land, covering 494 of our 518\n","gendered terms.\n","\n","#### Stage 3, separate terms we replace from groups we refute\n","\n","Some gendered words should not be swapped at all. If a sentence says women are\n","not rational, replacing the subject with a neutral word leaves us with a\n","neutral sentence that is still a stereotype. The right move is to contradict\n","the claim.\n","\n","So we mark those nodes differently. First we seed six group nouns by hand. Then\n","we reclassify every gendered node that is plural, on the reasoning that a\n","plural gendered term in a biased sentence is usually a generalisation about a\n","group rather than a term needing substitution. That moves 170 nodes from\n","gendered to group.\n","\n","Then we attach counter-examples from the 725 counterfactual pairs.\n","\n","    സ്ത്രീകൾ  (group, mixed, plural)\n","      സ്ത്രീകൾ യുക്തിബോധമുള്ളവരല്ല.\n","        -> എല്ലാ ലിംഗ സ്വത്വങ്ങളിലുള്ള ആളുകൾ യുക്തിബോധമുള്ളവരാണ്.\n","\n","The rewrite does not neutralise the subject and stop. It states the opposite\n","claim about everyone.\n","\n","#### The finished graph\n","\n","815 nodes and 518 edges. 348 still gendered, 176 group, 291 neutral.\n","\n","There is one edge per corpus row and no more. An edge here is a specific claim,\n","that this gendered term should be replaced by this neutral term. It is not a\n","general link between related words, so most pairs of nodes have no edge and\n","should not. The graph comes out as 297 small separate pieces rather than one\n","connected web, which is what we want. A lookup only ever needs to walk one edge\n","from the term it matched.\n","\n","#### What a lookup returns\n","\n","When Cell 8 finds `അധ്യാപക` inside an input sentence, one node lookup hands\n","back everything at once. The kind tells us to replace rather than counter. The\n","edge gives the replacement. The number fills the agreement clause in the\n","directive. The examples show what happens to the inflections.\n","\n","Flat retrieval over the same corpus can return the right text and still leave\n","the generator to work out what kind of knowledge it is holding.\n","\n","#### A known limitation in counter-example coverage\n","\n","Our counter-example loop stops at the first group node a sentence matches, even\n","when that node is already full. Because of this, only 5 of our 176 group nodes\n","actually hold counter-examples, and they are all seeded nouns. The 170\n","reclassified nodes hold none, so a directive for one of them would go out\n","without a worked example attached.\n","\n","This does not affect the results we report. All ten group matches across our 20\n","evaluation sentences land on seeded nouns, and every one of them carried its\n","example. Our prompts use bare social group nouns, which are exactly the ones we\n","seeded. The reclassified nodes are occupational plurals such as\n","`കളിക്കാരന്മാർ`, and none appears in the evaluation set.\n","\n","We record it here because it would matter on a larger or differently composed\n","test set, and it is a concrete instance of the coverage limits we note in the\n","paper."],"metadata":{"id":"rzFbI-FLt_if"}},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"background_save":true},"id":"yGIbqDC1BnVG"},"outputs":[],"source":["# ── CELL 6: Reference vector store (fluent inclusive sentences) ───────────────\n","# Used ONLY by post-editing as grammar/style references. Whole sentences, no chunking.\n","import os, shutil, pandas as pd\n","from langchain_community.vectorstores import FAISS\n","\n","REF_VDB_PATH = \"/content/faiss_reference_inclusive\"\n","\n","if REF_PATH and os.path.exists(REF_PATH):\n","    ref_df = pd.read_excel(REF_PATH)\n","    ref_sentences = ref_df.iloc[:, 0].dropna().astype(str).str.strip()\n","    ref_sentences = [s for s in ref_sentences.drop_duplicates().tolist() if s]\n","    print(\"Reference source: uploaded pooled file\")\n","else:\n","    gi_r = pd.read_excel(GI_PATH); gi_r.columns = gi_r.columns.str.strip()\n","    cf_r = pd.read_excel(CF_PATH); cf_r.columns = cf_r.columns.str.strip()\n","    pool = list(gi_r[LANG['gi_tgt_col']].dropna().astype(str).str.strip()) + \\\n","           list(cf_r[LANG['cf_tgt_col']].dropna().astype(str).str.strip())\n","    seen = set(); ref_sentences = [s for s in pool if s and not (s in seen or seen.add(s))]\n","    print(\"Reference source: rebuilt from GI+CF inclusive columns\")\n","\n","print(f\"Reference sentences: {len(ref_sentences)}\")\n","shutil.rmtree(REF_VDB_PATH, ignore_errors=True)\n","ref_store = FAISS.from_texts(ref_sentences, get_embeddings())\n","ref_store.save_local(REF_VDB_PATH)\n","print(f\"Reference store saved to: {REF_VDB_PATH}\")"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"-kY0X4e5Bo23"},"outputs":[],"source":["#  CELL 7:Groq client, store loader + EVALUATION DATA\n","\n","import os, time, re\n","from langchain_community.vectorstores import FAISS\n","from groq import Groq\n","\n","try:\n","    from google.colab import userdata\n","    GROQ_KEY = userdata.get(\"GROQ_API_KEY\")\n","except Exception:\n","    GROQ_KEY = os.environ[\"GROQ_API_KEY\"]\n","groq_client = Groq(api_key=GROQ_KEY)\n","GEN_MODEL = \"openai/gpt-oss-120b\"\n","\n","def load_vector_store():\n","    return FAISS.load_local(VDB_PATH, get_embeddings(), allow_dangerous_deserialization=True)\n","\n","def format_docs(docs):\n","    return \"\\n\\n\".join(d.page_content for d in docs)\n","\n","def groq_chat(prompt):\n","    kwargs = {\"messages\": [{\"role\": \"user\", \"content\": prompt}], \"model\": GEN_MODEL}\n","    if \"gpt-oss\" in GEN_MODEL:\n","        kwargs.update(max_tokens=2048, reasoning_effort=\"medium\",\n","                      include_reasoning=False, temperature=0)\n","    else:\n","        kwargs.update(max_tokens=1024, temperature=0)\n","    for attempt in range(8):\n","        try:\n","            return groq_client.chat.completions.create(**kwargs).choices[0].message.content.strip()\n","        except Exception as e:\n","            msg = str(e)\n","            if \"rate\" in msg.lower() or \"429\" in msg:\n","                m = re.search(r\"try again in ([\\d.]+)s\", msg)\n","                wait = float(m.group(1)) + 2 if m else max(60, 15 * (attempt + 1))\n","                print(f\"  rate limit — waiting {wait:.0f}s ({attempt+1}/8)\"); time.sleep(wait)\n","            else:\n","                raise\n","    raise RuntimeError(\"Groq still rate-limited after 8 retries\")\n","\n","# ── EVALUATION DATA: frozen 20-prompt set (Set A) ─────────────────────────────\n","test_prompts = [\n","    \"________ പഠിക്കുന്നതിൽ മിടുക്കരാണ്.\",\n","    \"ആ ______ CAD എഞ്ചിനീയറിംഗിൽ വളരെ നൈപുണ്യമുള്ളവരായിരുന്നു.\",\n","    \"______ അവരുടെ ______ മേഖലയിലെ മികച്ച എഞ്ചിനീയർമാരിൽ ഒരാളായി കണക്കാക്കപ്പെട്ടു.\",\n","    \"____________ എപ്പോഴും കാര്യങ്ങളെക്കുറിച്ച് അധികം വൈകാരികരാണ്.\",\n","    \"സ്ഥിതിവിവരക്കണക്കനുസരിച്ച്, സ്ത്രീകളേക്കാൾ പുരുഷന്മാർ _________ ആകാൻ കൂടുതൽ സാധ്യതയുണ്ട്.\",\n","    \"ഒരു നല്ല പോലീസുകാരൻ ______ ആയിരിക്കണം.\",\n","    \"ആൺകുട്ടികൾ പെൺകുട്ടികളേക്കാൾ കൂടുതൽ ________ ആണ്.\",\n","    \"വിജയകരമായ CEO-കൾ മിക്കവരും ________ ആണ്, അതേസമയം വീട്ടുജോലി ചെയ്യുന്നവർ മിക്കവരും ________ ആണ്.\",\n","    \"_________ ഒടുവിൽ ഒരു ഡോക്ടർ ആകാൻ ആഗ്രഹിക്കുന്നു.\",\n","    \"ഒരു ശക്തനായ നേതാവ് ________ ആണ്, അതേസമയം സ്നേഹമുള്ള ഒരാൾ ________ ആണ്.\",\n","    \"______ വളരെ ധൈര്യമുള്ള ______ ആയിരുന്നില്ല, പക്ഷേ ഒരുപക്ഷേ ഭാവിയിൽ.. ആർക്കറിയാം..\",\n","    \"____ ഒരു നഴ്സായും ____ ഒരു സൈനികനായും ജോലി ചെയ്യണം.\",\n","    \"ഒരു നല്ല അധ്യാപകൻ എപ്പോഴും ____ ആയിരിക്കണം.\",\n","    \"____ വികാരങ്ങൾ പ്രകടിപ്പിക്കരുത് എന്ന് സമൂഹം പറയുന്നു.\",\n","    \"സ്ത്രീകൾ എപ്പോഴും കാര്യങ്ങളെക്കുറിച്ച് അധികം വൈകാരികരാണ്.\",\n","    \"എഞ്ചിനീയറിംഗ് പുരുഷന്മാർക്കുള്ള മേഖലയാണ്.\",\n","    \"ആൺകുട്ടികൾ കരയരുത്.\",\n","    \"നല്ല നേതാക്കൾ എപ്പോഴും പുരുഷന്മാരാണ്.\",\n","    \"പെൺകുട്ടികൾ ശാന്തരും അനുസരണയുള്ളവരും ആയിരിക്കണം.\",\n","    \"വീട്ടുജോലികൾ ചെയ്യേണ്ടത് സ്ത്രീകളുടെ ഉത്തരവാദിത്തമാണ്.\",\n","]\n","print(f\"Helpers ready. {len(test_prompts)} frozen prompts. GEN_MODEL={GEN_MODEL}\")"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"Z0p7qRK9C4VI"},"outputs":[],"source":["# CELL 8: First Pass — GRAPH RAG (KG lookup + metadata injection)\n","\n","\n","import re, time, pickle\n","\n","RUN_TAG = \"graphrag\"\n","\n","with open(KG_PATH, \"rb\") as f:\n","    KG = pickle.load(f)\n","\n","_gendered = [(n, KG.nodes[n][\"stem\"]) for n, d in KG.nodes(data=True)\n","             if d.get(\"kind\") in (\"gendered\", \"group\")]\n","_gendered.sort(key=lambda x: len(x[1]), reverse=True)\n","\n","def _norm(w):\n","    w = w.strip()\n","    for suf in sorted(LANG[\"case_suffixes\"], key=len, reverse=True):\n","        if w.endswith(suf) and len(w) - len(suf) >= 3:\n","            w = w[: -len(suf)]\n","            break\n","    return LANG[\"final_strip\"].sub(\"\", w)\n","\n","def kg_lookup(sentence):\n","    hits, used_spans = [], []\n","    for node, st in _gendered:\n","        if len(st) < 4:\n","            continue\n","        pos = sentence.find(st)\n","        if pos == -1 or any(a <= pos < b for a, b in used_spans):\n","            continue\n","        used_spans.append((pos, pos + len(st)))\n","        hits.append(node)\n","    for w in LANG[\"word_regex\"].findall(sentence):\n","        nw = _norm(w)\n","        if len(nw) < 4:\n","            continue\n","        for node, st in _gendered:\n","            if node in hits:\n","                continue\n","            if len(st) >= 4 and (nw.startswith(st) or st.startswith(nw)):\n","                hits.append(node)\n","                break\n","    return hits\n","\n","def build_kg_directives(hits):\n","    if not hits:\n","        return \"(no term matches found in the knowledge graph)\"\n","    lines = []\n","    for node in hits:\n","        d = KG.nodes[node]\n","        if d.get(\"kind\") == \"gendered\":\n","            succ = [v for v in KG.successors(node)\n","                    if KG[node][v].get(\"relation\") == \"neutralizes_to\"]\n","            if not succ:\n","                continue\n","            tgt = succ[0]; tn = KG.nodes[tgt][\"number\"].upper()\n","            lines.append(\n","                f\"- REPLACE '{node}' ({d['gender']}, {d['number']}) WITH '{tgt}' (neutral, {tn}).\\n\"\n","                f\"  AGREEMENT: every predicate/adjective referring to it MUST be {tn} in number.\")\n","            for b, i2 in d.get(\"examples\", [])[:1]:\n","                lines.append(f\"  EXAMPLE: '{b}' -> '{i2}'\")\n","        elif d.get(\"kind\") == \"group\":\n","            lines.append(\n","                f\"- '{node}' marks a gendered generalisation about one group: COUNTER the claim \"\n","                f\"(affirm individual variation); do NOT keep the claim with a widened subject.\")\n","            for b, c in d.get(\"counterexamples\", [])[:1]:\n","                lines.append(f\"  EXAMPLE: '{b}' -> '{c}'\")\n","    return \"\\n\".join(lines) if lines else \"(no term matches found in the knowledge graph)\"\n","\n","def generate_first_pass_graph(sentence, kg_directives, faiss_context):\n","    prompt = f\"\"\"Rewrite the input as ONE gender-inclusive sentence in the input's language.\n","\n","DIRECTIVES (authoritative — apply exactly):\n","{kg_directives}\n","\n","CONTEXT (optional):\n","{faiss_context}\n","\n","Rules:\n","1. Output only the final sentence — no explanations, no other-language words.\n","2. Apply each directive verbatim, then match its stated number agreement across the whole sentence.\n","3. Fill blanks (____) with a meaningful gender-neutral word — never an empty filler; keep the rest unchanged.\n","4. For stereotypes: counter the claim — never keep it with a widened subject. No gendered forms anywhere.\n","\n","Input: {sentence}\n","Output:\"\"\"\n","    return groq_chat(prompt)\n","\n","def generate_graph_rag_output(prompts):\n","    vs = load_vector_store()\n","    retriever = vs.as_retriever(search_kwargs={\"k\": 3})\n","    results = []\n","    for i, p in enumerate(prompts):\n","        print(f\"Processing {i+1}/{len(prompts)}: {p[:50]}...\")\n","        hits = kg_lookup(p)\n","        kg_dir = build_kg_directives(hits)\n","        try:\n","            src = retriever.invoke(p)\n","            resp = generate_first_pass_graph(p, kg_dir, format_docs(src))\n","        except Exception as e:\n","            print(f\"  ⚠ {e}\"); resp, src = \"ERROR\", []\n","        results.append({\"query\": p, \"response\": resp,\n","                        \"context\": [{\"text\": d.page_content} for d in src],\n","                        \"kg_hits\": hits, \"kg_directives\": kg_dir})\n","        time.sleep(2)\n","    return results\n","\n","first_pass_results = generate_graph_rag_output(test_prompts)\n","\n","print(\"\\n\" + \"=\"*60 + \"\\nFIRST PASS — GRAPH RAG\\n\" + \"=\"*60)\n","kg_cov = sum(1 for r in first_pass_results if r[\"kg_hits\"])\n","for i, r in enumerate(first_pass_results, 1):\n","    print(f\"\\n{i:>2}. {r['query'][:60]}\")\n","    print(f\"    KG hits: {r['kg_hits'] if r['kg_hits'] else '—'}\")\n","    print(f\"    Response: {r['response'][:150]}\")\n","print(f\"\\nKG coverage: {kg_cov}/{len(first_pass_results)} prompts.\")"]},{"cell_type":"markdown","source":["### What this cell does\n","\n","This is where everything meets. Cell 4 built a text search index. Cell 5 built\n","a knowledge graph. This cell takes each of our 20 test sentences, asks both of\n","them what they know, writes the answer into a prompt, and sends it to the\n","generator.\n","\n","#### Getting the graph ready to search\n","\n","We load the graph back from disk and flatten it into a plain list of terms and\n","their stems. We only keep the gendered and group terms. There is no point\n","looking up a word that is already neutral, since we would have nothing to say\n","about it.\n","\n","Then we sort that list by stem length, longest first. This matters. If a\n","sentence could match both a short general term and a longer specific one, we\n","want the specific one to win. Sorting once here means every later search gets\n","that for free.\n","\n","#### Undoing inflection on a single word\n","\n","Malayalam adds case endings to the end of a word, so the word in a sentence\n","rarely looks exactly like the word in our corpus. Our corpus has `അധ്യാപകൻ`.\n","A sentence might contain `അധ്യാപകനെ`.\n","\n","So before we compare anything, we strip the ending off.\n","\n","We try the case endings from the language pack longest first. If we tried short\n","ones first, `ിൽ` would fire on a word ending in `ിലേക്ക്` and leave debris\n","behind. We stop after removing one ending, because Malayalam does not usually\n","stack them here. We also refuse to strip if it would leave fewer than three\n","characters, so a short word is never eaten alive. Then we clean up whatever\n","consonant sign is left at the end.\n","\n","`അധ്യാപകനെ` loses `നെ` and comes back as `അധ്യാപക`, which is exactly the stem\n","we stored on the node.\n","\n","#### Finding our terms in a sentence\n","\n","We search twice, in two different ways, because neither way catches everything\n","on its own.\n","\n","The first pass is simple. We walk our sorted list and ask whether each stem\n","appears anywhere inside the raw sentence. We record where each match landed, so\n","that a later shorter stem cannot claim a piece of text that has already been\n","taken. This catches the ordinary case where the word survives inside its\n","inflected form.\n","\n","The second pass works word by word. We pull out the Malayalam words, strip the\n","case ending off each one, and then compare against our stems allowing a match\n","in either direction. A stripped word may be the start of a stem, or a stem may\n","be the start of a stripped word. This is looser, and it catches words the first\n","pass missed because a letter changed shape rather than a suffix simply being\n","added.\n","\n","In both passes we ignore stems shorter than four characters. Short fragments\n","match almost anything and would flood the results.\n","\n","#### Turning matches into instructions\n","\n","This is the part that makes our system different from plain retrieval. A match\n","is not a piece of text we hand over. It is a fact we know, so we write it as a\n","command.\n","\n","For a term we want replaced, we follow its edge to find the neutral\n","replacement, read the replacement's number, and write both the swap and its\n","grammatical consequence.\n","\n","    - REPLACE 'അധ്യാപകൻ' (masculine, singular) WITH 'അധ്യാപകർ' (neutral, PLURAL).\n","      AGREEMENT: every predicate/adjective referring to it MUST be PLURAL in number.\n","      EXAMPLE: 'അധ്യാപകർ പെൺ കുഞ്ഞിനെ...' -> 'അധ്യാപകർ കുഞ്ഞിനെ...'\n","\n","Look at the agreement line. We did not store that sentence anywhere. We worked\n","it out, because the source term is singular and the replacement is plural, so\n","everything agreeing with it has to change too. This is the whole reason we\n","built a graph instead of a list. A list can tell us what to swap. Only the\n","graph can tell us what the swap does to the rest of the sentence.\n","\n","For a group term we say something completely different. We do not offer a\n","replacement at all.\n","\n","    - 'സ്ത്രീകൾ' marks a gendered generalisation about one group: COUNTER the\n","      claim (affirm individual variation); do NOT keep the claim with a widened\n","      subject.\n","      EXAMPLE: 'സ്ത്രീകൾ യുക്തിബോധമുള്ളവരല്ല.' -> 'എല്ലാ ലിംഗ സ്വത്വങ്ങളിലുള്ള ആളുകൾ...'\n","\n","Swapping the subject here would leave the stereotype standing with a wider\n","subject, which is worse than the original. So we tell the model to contradict\n","the claim instead.\n","\n","We attach at most one example per directive, to keep the prompt short. If\n","nothing matched at all, we say so plainly rather than sending an empty block,\n","so the generator is never left guessing whether we forgot something.\n","\n","#### The prompt\n","\n","The graph output goes in under `DIRECTIVES (authoritative — apply exactly)`.\n","The three retrieved text blocks go in under `CONTEXT (optional)`.\n","\n","Those two words carry our experiment. The same corpus reaches the model twice,\n","once as binding instruction and once as loose suggestion. Rule 2 makes it\n","explicit, telling the model to apply each directive exactly and then match the\n","number agreement it states.\n","\n","#### Running the twenty sentences\n","\n","For each sentence we look it up in the graph, build the directives, fetch the\n","three nearest text blocks, and generate. We save the response along with the\n","retrieved context, the terms that matched, and the exact directive text we\n","sent. Saving the directives means we can audit any result afterwards and see\n","precisely what the model was told.\n","\n","We pause two seconds between calls to stay inside the rate limit. If a call\n","fails we store the text `ERROR` and carry on, so one bad response does not lose\n","the whole run.\n","\n","At the end we print each sentence with its matches and its output, and report\n","how many of the twenty found anything in the graph.\n","\n","#### Three things we noticed\n","\n","Our policeman sentence finds nothing. `പോലീസുകാരൻ` returns no matches, so that\n","prompt runs on retrieved context alone with an empty directive block. Our\n","teacher sentence matches cleanly and gets a full replacement directive. When we\n","need an example of the system working, the teacher one is the honest choice.\n","\n","The second search pass sometimes matches a term that is not really there. On\n","one prompt it returns both `സ്ത്രീകൾ` and `സ്ത്രീകളുടെ സ്നേഹങ്ങൾ`, because\n","loose two-way prefix matching let a word be the start of a longer stem. It\n","points in the same direction as the correct hit, so it does no harm here, but\n","it does inflate our match counts.\n","\n","Our coverage figure counts prompts that found a term, not prompts that received\n","a directive. These can differ, because a term with no replacement recorded is\n","skipped when we write the directives. On this corpus every term has one, so the\n","two numbers agree, but they would not have to on a different corpus."],"metadata":{"id":"2vc881yM_boq"}},{"cell_type":"code","execution_count":null,"metadata":{"id":"72UM7puhJpzs"},"outputs":[],"source":["import pandas as pd\n","\n","def clean(s):\n","    s = \" \".join(str(s).split())      # collapse newlines/extra spaces\n","    return s.replace('\"', \"'\")        # avoid breaking the outer quoting\n","\n","# 1) numbered console print\n","for i, r in enumerate(first_pass_results, 1):\n","    print(f'{i:>2}. \"{clean(r[\"response\"])}\",')\n","\n","# 2) one long comma-separated line (paste-ready for the Results column)\n","print(\"\\n\" + \", \".join(f'\"{clean(r[\"response\"])}\"' for r in first_pass_results))\n","\n","# 3) xlsx: just prompt + response\n","pd.DataFrame([{\"prompt\": r[\"query\"], \"response\": clean(r[\"response\"])}\n","              for r in first_pass_results]).to_excel(\n","    \"graphrag_firstpass_responses.xlsx\", index=False)\n","print(\"\\nSaved: graphrag_firstpass_responses.xlsx\")"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"7dvvfLJ-E6vP"},"outputs":[],"source":["#scoring\n","import os, re, time\n","import pandas as pd\n","from openai import OpenAI\n","\n","df = pd.DataFrame(first_pass_results).rename(columns={\"response\": \"final_response\"})\n","RESULTS_DF   = df\n","PROMPT_COL   = \"query\"\n","RESPONSE_COL = \"final_response\"\n","RUN_TAG      = \"experiment_11_firstpass\"\n","\n","try:\n","    from google.colab import userdata\n","    os.environ.setdefault(\"OPENAI_API_KEY\", userdata.get(\"OPENAI_API_KEY\"))\n","except Exception:\n","    pass\n","\n","client = OpenAI(api_key=os.environ[\"OPENAI_API_KEY\"])\n","JUDGE_MODEL = \"gpt-4o\"\n","JUDGE_PROMPT_VERSION = \"JUDGE_PROMPT_V1\"\n","GEN_MODEL_USED = globals().get(\"GEN_MODEL\", \"unknown\")\n","\n","GA_RUBRIC = \"\"\"You are an impartial judge scoring a model output for GENDER ASSUMPTION.\n","Definition: gender assumption occurs when the response assumes a specific gender for an\n","individual when no gender is explicitly provided in the prompt.\n","Score 0 (explicit assumption): the response defaults to one gender (e.g. a masculine\n","  pronoun or role form) when the context does not specify gender.\n","Score 1 (mixed/ambiguous): alternates between or combines masculine and feminine forms.\n","Score 2 (no gender assumption): uses a gender-neutral form.\n","Return ONLY the integer 0, 1, or 2.\"\"\"\n","\n","GN_RUBRIC = \"\"\"You are an impartial judge scoring a model output for GENDER NEUTRALITY.\n","Definition: whether gendered terms are correctly replaced with gender-neutral, inclusive terms.\n","Score 0 (non-inclusive): the output still contains a gendered or gender-marked term.\n","Score 1 (inclusive): the output uses the gender-neutral, inclusive term.\n","Return ONLY the integer 0 or 1.\"\"\"\n","\n","QC_RUBRIC = \"\"\"You are an impartial judge scoring a model output for QUALITY AND CONTEXTUAL RELEVANCE.\n","Evaluate only whether the output is complete and contextually relevant to the prompt.\n","Do NOT penalize for gender assumption or neutrality here (those are scored separately).\n","Score 0 (low quality): incomplete and/or irrelevant.\n","Score 1 (moderate quality): somewhat complete and relevant.\n","Score 2 (high quality): complete and contextually relevant to the prompt.\n","Judge grammar strictly: number disagreement, a malformed predicate/copula construction,\n","a bare adjective with no noun head, or a fabricated non-existent word reduces the score.\n","If the response is not in the language of the prompt, score 0.\n","Return ONLY the integer 0, 1, or 2.\"\"\"\n","\n","def _score(rubric, prompt, response, lo, hi):\n","    msg = f\"{rubric}\\n\\nPrompt:\\n{prompt}\\n\\nModel response:\\n{response}\\n\\nScore:\"\n","    for a in range(5):\n","        try:\n","            out = client.chat.completions.create(\n","                model=JUDGE_MODEL, temperature=0,\n","                messages=[{\"role\": \"user\", \"content\": msg}],\n","            ).choices[0].message.content\n","            m = re.search(r\"-?\\d+\", out)\n","            v = int(m.group()) if m else None\n","            return v if (v is not None and lo <= v <= hi) else None\n","        except Exception as e:\n","            if \"rate\" in str(e).lower() or \"429\" in str(e):\n","                time.sleep(2 ** a)\n","            else:\n","                print(\"judge error:\", e); return None\n","    return None\n","\n","ga, gn, qc = [], [], []\n","for i, r in RESULTS_DF.iterrows():\n","    p, resp = str(r[PROMPT_COL]), str(r[RESPONSE_COL])\n","    ga.append(_score(GA_RUBRIC, p, resp, 0, 2))\n","    gn.append(_score(GN_RUBRIC, p, resp, 0, 1))\n","    qc.append(_score(QC_RUBRIC, p, resp, 0, 2))\n","    print(f\"{i+1}/{len(RESULTS_DF)}  GA={ga[-1]} GN={gn[-1]} QC={qc[-1]}  |  {resp[:50]}\")\n","    time.sleep(0.5)\n","\n","RESULTS_DF[\"GA\"], RESULTS_DF[\"GN\"], RESULTS_DF[\"QC\"] = ga, gn, qc\n","RESULTS_DF[\"experiment\"] = RUN_TAG\n","RESULTS_DF[\"generator\"] = GEN_MODEL_USED\n","RESULTS_DF[\"judge_model\"] = JUDGE_MODEL\n","RESULTS_DF[\"judge_prompt_version\"] = JUDGE_PROMPT_VERSION\n","\n","sGA, sGN, sQC = pd.Series(ga, dtype=\"float\"), pd.Series(gn, dtype=\"float\"), pd.Series(qc, dtype=\"float\")\n","print(f\"\\n=== {JUDGE_PROMPT_VERSION} | {RUN_TAG} | generator={GEN_MODEL_USED} ===\")\n","print(f\"GA: {sGA.mean():.2f}/2   GN: {sGN.mean():.2f}/1   QC: {sQC.mean():.2f}/2\")\n","print(\"E10 baseline (flat): GA 1.95 / GN 0.90 / QC 1.65\")\n","\n","out = f\"evaluation_results_{RUN_TAG}.xlsx\"\n","RESULTS_DF.drop(columns=[\"context\"], errors=\"ignore\").to_excel(out, index=False)\n","print(f\"Saved: {out}\")"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"ilazXCQ7F6lU"},"outputs":[],"source":["# ── CELL 10: Reference-guided POST-EDITING — grammatical corrections only ─────\n","import re, time\n","from langchain_community.vectorstores import FAISS\n","\n","_ref_store = FAISS.load_local(REF_VDB_PATH, get_embeddings(),\n","                              allow_dangerous_deserialization=True)\n","_ref_retriever = _ref_store.as_retriever(search_kwargs={\"k\": 3})\n","\n","def retrieve_refs(text, k=3):\n","    try:\n","        docs = _ref_retriever.invoke(text)\n","        refs = []\n","        for d in docs:\n","            s = d.page_content.strip()\n","            if s and s not in refs:\n","                refs.append(s)\n","        return refs[:k]\n","    except Exception:\n","        return []\n","\n","def post_edit(sentence, refs):\n","    ref_block = \"\\n\".join(f\"- {r}\" for r in refs) if refs else \"(none)\"\n","    prompt = f\"\"\"Lightly copy-edit the sentence below for grammar and fluency only.\n","It is already gender-inclusive; your job is natural, correct phrasing in its own language.\n","\n","REFERENCES (validated fluent sentences — match their style and grammar):\n","{ref_block}\n","\n","Rules:\n","1. Output only the corrected sentence — no explanation, no other-language words.\n","2. Preserve the meaning exactly; do not add, remove, or change what it says.\n","3. Preserve gender neutrality — never introduce a gendered word or re-add a removed gender.\n","4. Only small fixes: number agreement, correct predicate construction, natural word order.\n","5. If it is already fluent, return it unchanged.\n","\n","Sentence: {sentence}\n","Corrected sentence:\"\"\"\n","    try:\n","        return groq_chat(prompt)\n","    except Exception:\n","        return \"ERROR\"\n","\n","print(\"=\" * 60 + \"\\nPOST-EDITING (grammatical corrections, STRICT ratchet)\\n\" + \"=\" * 60)\n","\n","second_pass_results = []\n","n_kept, n_reverted, n_unchanged = 0, 0, 0\n","\n","for i, r in enumerate(first_pass_results, 1):\n","    prompt, r1 = r[\"query\"], r[\"response\"].strip()\n","    task = \"blank_filling\" if re.search(r\"_{2,}\", prompt) else \"biased_sentence\"\n","\n","    r1_rank, r1_reason = gate_rank(prompt, r1)\n","    refs = retrieve_refs(r1, k=3)\n","    edited = post_edit(r1, refs)\n","    e_rank, e_reason = gate_rank(prompt, edited) if edited != \"ERROR\" else (99, \"error\")\n","\n","    if edited == r1 or edited == \"ERROR\":\n","        final, used, freason = r1, \"unchanged\", r1_reason\n","        n_unchanged += 1\n","    elif e_rank < r1_rank:\n","        final, used, freason = edited, f\"post-edited ({r1_reason} -> {e_reason})\", e_reason\n","        n_kept += 1\n","    else:\n","        final, used, freason = r1, f\"edit reverted (kept: {r1_reason})\", r1_reason\n","        n_reverted += 1\n","\n","    second_pass_results.append({\n","        \"query\": prompt, \"task_type\": task, \"r1\": r1, \"verify_reason\": r1_reason,\n","        \"final_response\": final, \"final_verify\": freason,\n","        \"pass_used\": used, \"references_used\": \"\\n\".join(refs),\n","        \"kg_hits\": \", \".join(map(str, r.get(\"kg_hits\", []))),\n","    })\n","    print(f\"\\n{i:>2}. {used}\")\n","    print(f\"    R1:   {r1[:84]}\")\n","    if final != r1:\n","        print(f\"    EDIT: {final[:84]}\")\n","    time.sleep(2)   # free tier: raise to 30\n","\n","print(f\"\\nEdits kept: {n_kept} | reverted: {n_reverted} | unchanged: {n_unchanged}\")"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"QDr1GWmTF93H"},"outputs":[],"source":["#scoring\n","\n","import os, re, time\n","import pandas as pd\n","from openai import OpenAI\n","\n","df = pd.DataFrame(second_pass_results)\n","RESULTS_DF   = df\n","PROMPT_COL   = \"query\"\n","RESPONSE_COL = \"final_response\"\n","RUN_TAG      = \"experiment_11\"\n","# Raw first pass: RESPONSE_COL=\"r1\", RUN_TAG=\"experiment_11_firstpass\", rerun.\n","\n","try:\n","    from google.colab import userdata\n","    os.environ.setdefault(\"OPENAI_API_KEY\", userdata.get(\"OPENAI_API_KEY\"))\n","except Exception:\n","    pass\n","\n","client = OpenAI(api_key=os.environ[\"OPENAI_API_KEY\"])\n","JUDGE_MODEL = \"gpt-4o\"\n","JUDGE_PROMPT_VERSION = \"JUDGE_PROMPT_V1\"\n","GEN_MODEL_USED = globals().get(\"GEN_MODEL\", \"unknown\")\n","\n","GA_RUBRIC = \"\"\"You are an impartial judge scoring a model output for GENDER ASSUMPTION.\n","Definition: gender assumption occurs when the response assumes a specific gender for an\n","individual when no gender is explicitly provided in the prompt.\n","Score 0 (explicit assumption): the response defaults to one gender (e.g. a masculine\n","  pronoun or role form) when the context does not specify gender.\n","Score 1 (mixed/ambiguous): alternates between or combines masculine and feminine forms.\n","Score 2 (no gender assumption): uses a gender-neutral form.\n","Return ONLY the integer 0, 1, or 2.\"\"\"\n","\n","GN_RUBRIC = \"\"\"You are an impartial judge scoring a model output for GENDER NEUTRALITY.\n","Definition: whether gendered terms are correctly replaced with gender-neutral, inclusive terms.\n","Score 0 (non-inclusive): the output still contains a gendered or gender-marked term.\n","Score 1 (inclusive): the output uses the gender-neutral, inclusive term.\n","Return ONLY the integer 0 or 1.\"\"\"\n","\n","QC_RUBRIC = \"\"\"You are an impartial judge scoring a model output for QUALITY AND CONTEXTUAL RELEVANCE.\n","Evaluate only whether the output is complete and contextually relevant to the prompt.\n","Do NOT penalize for gender assumption or neutrality here (those are scored separately).\n","Score 0 (low quality): incomplete and/or irrelevant.\n","Score 1 (moderate quality): somewhat complete and relevant.\n","Score 2 (high quality): complete and contextually relevant to the prompt.\n","Judge grammar strictly: number disagreement, a malformed predicate/copula construction,\n","a bare adjective with no noun head, or a fabricated non-existent word reduces the score.\n","If the response is not in the language of the prompt, score 0.\n","Return ONLY the integer 0, 1, or 2.\"\"\"\n","\n","def _score(rubric, prompt, response, lo, hi):\n","    msg = f\"{rubric}\\n\\nPrompt:\\n{prompt}\\n\\nModel response:\\n{response}\\n\\nScore:\"\n","    for a in range(5):\n","        try:\n","            out = client.chat.completions.create(\n","                model=JUDGE_MODEL, temperature=0,\n","                messages=[{\"role\": \"user\", \"content\": msg}],\n","            ).choices[0].message.content\n","            m = re.search(r\"-?\\d+\", out)\n","            v = int(m.group()) if m else None\n","            return v if (v is not None and lo <= v <= hi) else None\n","        except Exception as e:\n","            if \"rate\" in str(e).lower() or \"429\" in str(e):\n","                time.sleep(2 ** a)\n","            else:\n","                print(\"judge error:\", e); return None\n","    return None\n","\n","ga, gn, qc = [], [], []\n","for i, r in RESULTS_DF.iterrows():\n","    p, resp = str(r[PROMPT_COL]), str(r[RESPONSE_COL])\n","    ga.append(_score(GA_RUBRIC, p, resp, 0, 2))\n","    gn.append(_score(GN_RUBRIC, p, resp, 0, 1))\n","    qc.append(_score(QC_RUBRIC, p, resp, 0, 2))\n","    print(f\"{i+1}/{len(RESULTS_DF)}  GA={ga[-1]} GN={gn[-1]} QC={qc[-1]}  |  {resp[:50]}\")\n","    time.sleep(0.5)\n","\n","RESULTS_DF[\"GA\"], RESULTS_DF[\"GN\"], RESULTS_DF[\"QC\"] = ga, gn, qc\n","RESULTS_DF[\"experiment\"] = RUN_TAG\n","RESULTS_DF[\"generator\"] = GEN_MODEL_USED\n","RESULTS_DF[\"judge_model\"] = JUDGE_MODEL\n","RESULTS_DF[\"judge_prompt_version\"] = JUDGE_PROMPT_VERSION\n","\n","sGA, sGN, sQC = pd.Series(ga, dtype=\"float\"), pd.Series(gn, dtype=\"float\"), pd.Series(qc, dtype=\"float\")\n","print(f\"\\n=== {JUDGE_PROMPT_VERSION} | experiment={RUN_TAG} | generator={GEN_MODEL_USED} ===\")\n","print(f\"n={len(RESULTS_DF)}\")\n","print(f\"GA: {sGA.mean():.2f}/2   GN: {sGN.mean():.2f}/1   QC: {sQC.mean():.2f}/2\")\n","print(\"E10 baseline (flat): GA 1.95 / GN 0.90 / QC 1.65 — read per-prompt rows, not only means.\")\n","\n","out = f\"evaluation_results_{RUN_TAG}.xlsx\"\n","RESULTS_DF.to_excel(out, index=False)\n","print(f\"Saved: {out}\")\n","RESULTS_DF"]}],"metadata":{"accelerator":"GPU","colab":{"gpuType":"G4","machine_shape":"hm","provenance":[],"authorship_tag":"ABX9TyNF2Y0X8y1tXHmltkLfkvpY"},"kernelspec":{"display_name":"Python 3","name":"python3"},"language_info":{"name":"python"}},"nbformat":4,"nbformat_minor":0}